          "name": "registration_invitations_recipient_email_normalized_check",
          "value": "\"registration_invitations\".\"recipient_email\" = lower(btrim(\"registration_invitations\".\"recipient_email\"))"
        },
        "registration_invitations_token_hash_check": {
          "name": "registration_invitations_token_hash_check",
          "value": "\"registration_invitations\".\"token_hash\" ~ '^[0-9a-f]{64}$'"
        },
        "registration_invitations_source_check": {
          "name": "registration_invitations_source_check",
          "value": "\"registration_invitations\".\"source\" IN ('admin', 'member')"
        },
        "registration_invitations_status_check": {
          "name": "registration_invitations_status_check",
          "value": "\"registration_invitations\".\"status\" IN ('pending', 'accepted', 'expired', 'revoked', 'failed')"
        },
        "registration_invitations_member_slot_check": {
          "name": "registration_invitations_member_slot_check",
          "value": "(\n        (\"registration_invitations\".\"source\" = 'admin' AND \"registration_invitations\".\"member_slot\" IS NULL)\n        OR\n        (\"registration_invitations\".\"source\" = 'member' AND \"registration_invitations\".\"member_slot\" BETWEEN 1 AND 3)\n      )"
        },
        "registration_invitations_expiration_check": {
          "name": "registration_invitations_expiration_check",
          "value": "\"registration_invitations\".\"expires_at\" > \"registration_invitations\".\"created_at\""
        },
        "registration_invitations_acceptance_check": {
          "name": "registration_invitations_acceptance_check",
          "value": "(\n        (\"registration_invitations\".\"status\" = 'accepted' AND \"registration_invitations\".\"accepted_user_id\" IS NOT NULL AND \"registration_invitations\".\"accepted_at\" IS NOT NULL)\n        OR\n        (\"registration_invitations\".\"status\" <> 'accepted' AND \"registration_invitations\".\"accepted_user_id\" IS NULL AND \"registration_invitations\".\"accepted_at\" IS NULL)\n      )"
        },
        "registration_invitations_revocation_check": {
          "name": "registration_invitations_revocation_check",
          "value": "(\n        (\"registration_invitations\".\"status\" = 'revoked' AND \"registration_invitations\".\"revoked_at\" IS NOT NULL)\n        OR\n        (\"registration_invitations\".\"status\" <> 'revoked' AND \"registration_invitations\".\"revoked_at\" IS NULL)\n      )"
        },
        "registration_invitations_failure_check": {
          "name": "registration_invitations_failure_check",
          "value": "(\n        (\"registration_invitations\".\"status\" = 'failed' AND \"registration_invitations\".\"delivery_error\" IS NOT NULL)\n        OR\n        (\"registration_invitations\".\"status\" <> 'failed' AND \"registration_invitations\".\"delivery_error\" IS NULL)\n      )"
        }
      },
      "isRLSEnabled": true
