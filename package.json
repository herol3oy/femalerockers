{
  "name": "femalerockers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "prepare": "husky",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.development.local -- sh -c 'supabase db push --db-url \"$DATABASE_URL\" --include-all \"$@\"' --",
    "db:migrate:prod:dry": "dotenv -e .env.local -- sh -c 'supabase db push --db-url \"$MIGRATION_DATABASE_URL\" --include-all --dry-run'",
    "db:migrate:prod": "dotenv -e .env.local -- sh -c 'supabase db push --db-url \"$MIGRATION_DATABASE_URL\" --include-all \"$@\"' --",
    "db:push": "dotenv -e .env.development.local -- sh -c 'supabase db push --db-url \"$DATABASE_URL\" --include-all \"$@\"' --",
    "db:push:prod": "dotenv -e .env.local -- sh -c 'supabase db push --db-url \"$MIGRATION_DATABASE_URL\" --include-all \"$@\"' --"
  },
  "dependencies": {
    "@countrystatecity/countries": "^1.0.7",
    "@getbrevo/brevo": "^6.0.2",
    "@phosphor-icons/react": "^2.1.10",
    "@sanity/image-url": "^2.1.1",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.110.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "next": "16.2.10",
    "next-sanity": "^13.1.1",
    "next-themes": "^0.4.6",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "dotenv": "^17.4.2",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.77.0",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "oxfmt --write",
      "oxlint --fix"
    ]
  }
}
